---
import { Content as Overview } from '../content/Overview.md';
import { Content as Rules } from '../content/Rules.md';
import { Content as PastSeasons } from '../content/PastSeasons.md';
import { Content as TracklogRecording } from '../content/TracklogRecording.md';
import Register from './Register.astro';
import About from '../content/About.astro';
import Scoring from '../content/Scoring.astro';
// ComponentToggle.astro
// Set to true to bring back the Tracklog Upload tab and Leaderboard link (e.g. when a new season opens).
const SHOW_SEASON_TABS = false;
const tabs = [
  { id: 'overview', label: 'Overview' },
  { id: 'rules', label: 'Rules' },
  { id: 'tracklog-recording', label: 'Tracklog Help' },
  ...(SHOW_SEASON_TABS ? [{ id: 'scoring', label: 'Tracklog Upload' }] : []),
  { id: 'past-seasons', label: 'Past Seasons' },
  { id: 'register', label: 'Register' },
  { id: 'about', label: 'About' },
];
---

<div class="w-full max-w-4xl mx-auto p-4">
  <!-- Toggle Bar -->
  <div class="flex flex-col border-b border-gray-200 mb-6">
    <!-- Main tabs: Past Seasons and About wrap together when narrow -->
    <div class="flex flex-wrap justify-center">
      {tabs.filter(t => t.id !== 'scoring' && t.id !== 'past-seasons' && t.id !== 'register' && t.id !== 'about').map(tab => (
        <button
          class="tab-button px-4 sm:px-6 py-2 sm:py-3 text-sm sm:text-base text-gray-600 hover:text-gray-900 border-b-2 border-transparent transition-colors"
          data-tab={tab.id}
        >
          {tab.label}
        </button>
      ))}
      <div class="flex flex-wrap justify-center">
        <button
          class="tab-button px-4 sm:px-6 py-2 sm:py-3 text-sm sm:text-base text-gray-600 hover:text-gray-900 border-b-2 border-transparent transition-colors"
          data-tab="past-seasons"
        >
          Past Seasons
        </button>
        <button
          class="tab-button px-4 sm:px-6 py-2 sm:py-3 text-sm sm:text-base text-gray-600 hover:text-gray-900 border-b-2 border-transparent transition-colors"
          data-tab="register"
        >
          Register
        </button>
        <button
          class="tab-button px-4 sm:px-6 py-2 sm:py-3 text-sm sm:text-base text-gray-600 hover:text-gray-900 border-b-2 border-transparent transition-colors"
          data-tab="about"
        >
          About
        </button>
      </div>
    </div>
    {SHOW_SEASON_TABS && (
      <div class="flex flex-wrap justify-center border-t border-gray-100">
      <button
        class="tab-button px-4 sm:px-6 py-2 sm:py-3 text-sm sm:text-base text-gray-600 hover:text-gray-900 border-b-2 border-transparent transition-colors"
        data-tab="scoring"
      >
        Tracklog Upload
      </button>
      <a
        href="/leaderboard"
        class="px-4 sm:px-6 py-2 sm:py-3 text-sm sm:text-base text-gray-600 hover:text-gray-900 border-b-2 border-transparent transition-colors no-underline"
      >
        Leaderboard
      </a>
    </div>
    )}
  </div>

  <!-- Content Panels -->
  <div class="tab-content" data-content="overview">
    <Overview />
  </div>

  <div class="tab-content hidden" data-content="past-seasons">
    <PastSeasons />
  </div>
  
  <div class="tab-content hidden" data-content="rules">
    <Rules />
  </div>
  
  <div class="tab-content hidden" data-content="tracklog-recording">
    <TracklogRecording />
  </div>

  <div class="tab-content hidden" data-content="register">
    <Register />
  </div>

  <div class="tab-content hidden" data-content="about">
    <About />
  </div>
  
  {SHOW_SEASON_TABS && (
    <div class="tab-content hidden" data-content="scoring">
      <Scoring />
    </div>
  )}
</div>

<script>
  const buttons = document.querySelectorAll('.tab-button');
  const contents = document.querySelectorAll('.tab-content');

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const tabId = button.dataset.tab;

      // Remove active state from all buttons
      buttons.forEach(btn => {
        btn.classList.remove('border-brown-500', 'text-brown-600');
        btn.classList.add('border-transparent', 'text-gray-600');
      });

      // Add active state to clicked button
      button.classList.remove('border-transparent', 'text-gray-600');
      button.classList.add('border-brown-500', 'text-brown-600');

      // Hide all content
      contents.forEach(content => content.classList.add('hidden'));

      // Show selected content
      const activeContent = document.querySelector(`[data-content="${tabId}"]`);
      activeContent?.classList.remove('hidden');

      // Keep the URL in sync so tabs can be linked to (e.g. #register).
      // The first tab is the default, so it gets a clean URL.
      const hash = button === buttons[0] ? '' : `#${tabId}`;
      history.replaceState(null, '', `${location.pathname}${location.search}${hash}`);
    });
  });

  // Open the tab named in the URL hash, e.g. <a href="#register">.
  function openTabFromHash() {
    const tabId = location.hash.slice(1);
    const button = tabId && document.querySelector<HTMLElement>(`.tab-button[data-tab="${CSS.escape(tabId)}"]`);
    if (button) button.click();
  }
  window.addEventListener('hashchange', openTabFromHash);

  // Set initial active state
  buttons[0]?.classList.add('border-brown-500', 'text-brown-600');
  openTabFromHash();
</script>