---
import Base from "../layouts/Base.astro";
import Flightmap from "../components/Flightmap.astro";
---

<Base title="Flights - NorCal H&F">
  <div class="w-full max-w-4xl mx-auto p-4">
    <h1 class="text-center"><a id="leaderboard-link" href="/leaderboard" class="no-underline">Leaderboard</a></h1>
    <h2 id="user-heading">Flights</h2>

    <!-- Stats summary -->
    <div id="stats-bar" class="hidden gap-4 mb-6">
      <div class="bg-gray-50 rounded p-3 text-center">
        <div class="text-sm text-gray-500">Contest Score</div>
        <div id="stat-total-score" class="text-xl font-bold"></div>
      </div>
      <div class="bg-gray-50 rounded p-3 text-center">
        <div class="text-sm text-gray-500">Best Score</div>
        <div id="stat-best-score" class="text-xl font-bold"></div>
      </div>
      <div class="bg-gray-50 rounded p-3 text-center">
        <div class="text-sm text-gray-500">Total Flights</div>
        <div id="stat-flights" class="text-xl font-bold"></div>
      </div>
      <div class="bg-gray-50 rounded p-3 text-center">
        <div class="text-sm text-gray-500">Total Hiked</div>
        <div id="stat-total-km" class="text-xl font-bold"></div>
      </div>
      <div class="bg-gray-50 rounded p-3 text-center">
        <div class="text-sm text-gray-500">Total Vert</div>
        <div id="stat-total-elevation" class="text-xl font-bold"></div>
      </div>
      <div class="bg-gray-50 rounded p-3 text-center">
        <div class="text-sm text-gray-500">Avg Score</div>
        <div id="stat-avg-score" class="text-xl font-bold"></div>
      </div>
    </div>

    <div id="flights-loading" class="text-center text-gray-500 py-8">
      Loading flights...
    </div>

    <div id="flights-error" class="text-center text-red-600 py-8 hidden"></div>

    <div id="flights-table" class="hidden overflow-x-auto mb-6">
      <table class="w-full border-collapse">
        <thead>
          <tr class="border-b-2 border-gray-300">
            <th class="text-left py-2 px-3"><button class="sort-btn cursor-pointer hover:underline font-bold" data-key="date" data-label="Date">Date</button></th>
            <th class="text-right py-2 px-4"><button class="sort-btn cursor-pointer hover:underline font-bold" data-key="score" data-label="Score">Score</button></th>
            <th class="text-center py-2 px-1"></th>
            <th class="text-right py-2 px-2">Triangle (km)</th>
            <th class="text-right py-2 px-2"><button class="sort-btn cursor-pointer hover:underline font-bold" data-key="hiking_km" data-label="Hiking (km)">Hiking (km)</button></th>
            <th class="text-right py-2 px-2"><button class="sort-btn cursor-pointer hover:underline font-bold" data-key="elevation_gain_m" data-label="Vert (m)">Vert (m)</button></th>
            <th class="text-right py-2 px-2">Penalty (km)</th>
            <th class="text-right py-2 px-3">Duration</th>
            <th class="text-right py-2 px-3">Type</th>
            <th class="text-center py-2 px-3">Map</th>
            <th class="text-center py-2 px-2">Track</th>
          </tr>
        </thead>
        <tbody id="flights-body"></tbody>
      </table>
    </div>

  </div>

  <!-- Flight map pop-up. Opened by the View buttons; closes on ×, Esc or a click outside. -->
  <dialog
    id="map-dialog"
    aria-labelledby="map-dialog-title"
    class="m-auto w-[calc(100vw-1rem)] max-w-4xl max-h-[calc(100dvh-1rem)] overflow-y-auto rounded-xl p-0 shadow-2xl backdrop:bg-black/50"
  >
    <div class="p-3 sm:p-4">
      <div class="flex items-center justify-between gap-2 mb-2">
        <h3 id="map-dialog-title" class="py-0 md:py-0"></h3>
        <button
          id="map-dialog-close"
          type="button"
          aria-label="Close map"
          class="shrink-0 rounded-md px-2 text-2xl leading-none text-gray-500 hover:bg-gray-100 hover:text-gray-900 cursor-pointer"
        >&times;</button>
      </div>
      <div id="track-status" class="text-center text-gray-500 py-2 hidden" aria-live="polite"></div>
      <Flightmap />
    </div>
  </dialog>
</Base>

<script>
  import { R2_PUBLIC_URL } from "../config";
  import { parseFixes } from "../ts/parseFixes.ts";
  import { igcTimeZone, getTimezone } from "../ts/hf_scoring.ts";
  import { decodeDisplayTrack, displayFixesFromSource } from "../ts/display_track.ts";

  function formatDuration(seconds: number): string {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    return `${h}h ${m}m`;
  }

  function getUserId(): string | null {
    const params = new URLSearchParams(window.location.search);
    return params.get("user");
  }

  const params = new URLSearchParams(window.location.search);
  const season = params.get("season") ?? "2026";
  const prefix = `${season}/`;

  const leaderboardLink = document.getElementById("leaderboard-link") as HTMLAnchorElement;
  leaderboardLink.href = `/leaderboard?season=${season}`;
  leaderboardLink.textContent = season === "prologue" ? "Prologue Leaderboard" : `${season} Leaderboard`;

  let flights: any[] = [];
  let currentSort = "date";

  function renderFlights(sortKey: string) {
    currentSort = sortKey;
    const body = document.getElementById("flights-body")!;

    const sorted = [...flights].sort((a, b) => {
      if (sortKey === "date") return b.date.localeCompare(a.date);
      if (sortKey === "score") return b.score - a.score;
      if (sortKey === "hiking_km") return b.breakdown.hiking_km - a.breakdown.hiking_km;
      if (sortKey === "elevation_gain_m") return (b.breakdown.elevation_gain_m ?? 0) - (a.breakdown.elevation_gain_m ?? 0);
      return 0;
    });

    // The final score is the sum of a user's top 4 flights by score — highlight those rows.
    const TOP_N = 4;
    const counting = new Set(
      [...flights].sort((a, b) => b.score - a.score).slice(0, TOP_N)
    );

    body.innerHTML = sorted
      .map(
        (f: any) => `
      <tr class="${counting.has(f) ? "border-b border-gray-200 bg-gray-100 font-bold" : "border-b border-gray-200 hover:bg-gray-50"}">
        <td class="py-2 px-3">${f.date}</td>
        <td class="text-right py-2 px-3">${f.score.toFixed(1)}</td>
        <td class="text-center py-2 px-1">${f.breakdown?.friends_bonus ? '<sup class="text-blue-500 font-bold cursor-default" title="Fly with Friends bonus">★</sup>' : ''}</td>
        <td class="text-right py-2 px-3">${f.breakdown.triangle_km.toFixed(1)}</td>
        <td class="text-right py-2 px-3">${f.breakdown.hiking_km.toFixed(1)}</td>
        <td class="text-right py-2 px-3">${Math.round(f.breakdown.elevation_gain_m ?? 0).toLocaleString()}</td>
        <td class="text-right py-2 px-3">${f.breakdown.penalty_km.toFixed(1)}</td>
        <td class="text-right py-2 px-3">${formatDuration(f.duration_s)}</td>
        <td class="text-right py-2 px-3">${f.breakdown.closed ? "Closed" : "Open"} ${(f.breakdown.scoring_code || "tri").toUpperCase()}</td>
        <td class="text-center py-2 px-3">
          <button class="view-flight-btn text-blue-700 underline cursor-pointer" data-track="${f.track_file}" data-src="${f.source_key || ''}" data-lat="${f.launch_lat ?? ''}" data-lon="${f.launch_lon ?? ''}" data-title="${f.date} · ${f.score.toFixed(1)} pts">
            View
          </button>
        </td>
        <td class="text-center py-2 px-3">
          ${f.source_key ? `<button class="download-track-btn text-blue-700 underline cursor-pointer" data-src="${f.source_key}">↓</button>` : ''}
        </td>
      </tr>`
      )
      .join("");

    // Update sort button labels
    document.querySelectorAll<HTMLElement>(".sort-btn").forEach((btn) => {
      const label = btn.dataset.label!;
      btn.textContent = btn.dataset.key === sortKey ? `${label} ▼` : label;
    });

    // Wire up view buttons
    document.querySelectorAll(".view-flight-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const { track, src, lat, lon, title } = (btn as HTMLElement).dataset;
        openMapDialog(title ?? "");
        loadTrack(track!, src || '', lat ? Number(lat) : NaN, lon ? Number(lon) : NaN);
      });
    });

    // Wire up download buttons
    document.querySelectorAll(".download-track-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const src = (btn as HTMLElement).dataset.src!;
        const filename = src.split("/").pop()!;
        const res = await fetch(`${R2_PUBLIC_URL}/${src}`);
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = filename;
        a.click();
        URL.revokeObjectURL(url);
      });
    });
  }

  async function loadFlights() {
    const userId = getUserId();
    const loading = document.getElementById("flights-loading")!;
    const error = document.getElementById("flights-error")!;
    const table = document.getElementById("flights-table")!;
    const statsBar = document.getElementById("stats-bar")!;

    if (!userId) {
      loading.classList.add("hidden");
      error.textContent = "No user specified. Use ?user=<user_id> in the URL.";
      error.classList.remove("hidden");
      return;
    }

    try {
      const res = await fetch(
        `${R2_PUBLIC_URL}/${prefix}scores/users/${userId}.json`,
        { cache: 'no-store' }
      );
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      // Update heading with display name
      document.getElementById("user-heading")!.textContent =
        `Flights: ${data.display_name}`;

      // Stats
      const s = data.stats;
      document.getElementById("stat-total-score")!.textContent =
        s.total_score.toFixed(1);
      document.getElementById("stat-best-score")!.textContent =
        s.best_score.toFixed(1);
      document.getElementById("stat-flights")!.textContent =
        String(s.total_flights);
      document.getElementById("stat-total-km")!.textContent =
        s.total_km.toFixed(1);
      document.getElementById("stat-total-elevation")!.textContent =
        `${Math.round(s.total_elevation_gain_m ?? 0).toLocaleString()} m`;
      document.getElementById("stat-avg-score")!.textContent =
        s.avg_score.toFixed(1);
      statsBar.classList.remove("hidden");
      statsBar.classList.add("grid", "grid-cols-2", "md:grid-cols-6");

      flights = data.flights;
      renderFlights(currentSort);

      document.querySelectorAll<HTMLElement>(".sort-btn").forEach((btn) => {
        btn.addEventListener("click", () => renderFlights(btn.dataset.key!));
      });

      loading.classList.add("hidden");
      table.classList.remove("hidden");
    } catch (e: any) {
      loading.classList.add("hidden");
      error.textContent = `Failed to load flights: ${e.message}`;
      error.classList.remove("hidden");
    }
  }

  // Timezone lookups (timeapi.io, ~0.5 s each) are only needed for GPX sources
  // without trackData.display. Memoised per rounded location for the page session.
  // timeapi.io has no timeout of its own; if it stalls, fall back after a few
  // seconds to the same longitude-based estimate getTimezone() uses on error.
  const TZ_TIMEOUT_MS = 4000;
  const tzCache = new Map<string, Promise<string>>();
  function timezoneAt(lat: number, lon: number): Promise<string> {
    const key = `${lat.toFixed(2)},${lon.toFixed(2)}`;
    let p = tzCache.get(key);
    if (!p) {
      let timedOut = false;
      p = Promise.race([
        getTimezone(lat, lon),
        new Promise<string>((resolve) => setTimeout(() => {
          timedOut = true;
          const offset = Math.round(lon / 15);
          resolve(`Etc/GMT${offset > 0 ? '-' : '+'}${Math.abs(offset)}`);
        }, TZ_TIMEOUT_MS)),
      ]);
      tzCache.set(key, p);
      p.then(() => { if (timedOut) tzCache.delete(key); });
    }
    return p;
  }

  // --- Map pop-up ---
  const mapDialog = document.getElementById("map-dialog") as HTMLDialogElement;
  const mapDialogTitle = document.getElementById("map-dialog-title")!;

  function openMapDialog(title: string) {
    mapDialogTitle.textContent = title;
    if (!mapDialog.open) {
      mapDialog.showModal();
      document.documentElement.style.overflow = "hidden"; // stop the page scrolling behind
    }
  }
  mapDialog.addEventListener("close", () => {
    document.documentElement.style.overflow = "";
    latestLoad++; // drop any track still loading
  });
  document.getElementById("map-dialog-close")!.addEventListener("click", () => mapDialog.close());

  // Close on a click on the dimmed backdrop. A click there has the dialog itself
  // as its target. Require the press to start there too, so dragging the map or
  // scrubbing the chart and releasing outside doesn't close it.
  let pressStartedOnBackdrop = false;
  mapDialog.addEventListener("pointerdown", (e) => { pressStartedOnBackdrop = e.target === mapDialog; });
  mapDialog.addEventListener("click", (e) => {
    if (e.target === mapDialog && pressStartedOnBackdrop) mapDialog.close();
  });

  const trackStatus = document.getElementById("track-status")!;
  function setTrackStatus(text: string, isError = false) {
    trackStatus.textContent = text;
    trackStatus.classList.toggle("hidden", !text);
    trackStatus.classList.toggle("text-red-600", isError);
    trackStatus.classList.toggle("text-gray-500", !isError);
  }

  // Parsed tracks, so re-viewing a flight is instant.
  const detailCache = new Map<string, Promise<any>>();
  let latestLoad = 0;

  async function loadTrack(trackFile: string, sourceKey: string, launchLat: number, launchLon: number) {
    const loadId = ++latestLoad;
    setTrackStatus("Loading track…");
    let p = detailCache.get(trackFile);
    if (!p) {
      p = fetchTrackDetail(trackFile, sourceKey, launchLat, launchLon);
      detailCache.set(trackFile, p);
      p.catch(() => detailCache.delete(trackFile));
    }
    try {
      const detail = await p;
      // Ignore a slow load if the user has since clicked another flight
      if (loadId !== latestLoad) return;
      setTrackStatus("");
      document.dispatchEvent(new CustomEvent("igc-score-result", { detail }));
    } catch (e: any) {
      console.error("Failed to load track:", e);
      if (loadId === latestLoad) setTrackStatus(`Failed to load track: ${e.message}`, true);
    }
  }

  async function fetchTrackDetail(trackFile: string, sourceKey: string, launchLat: number, launchLon: number) {
    // Start the source download alongside the track JSON (as before) so tracks
    // without a display track don't pay an extra round trip, but abort it as
    // soon as the JSON turns out to contain one. Source files are immutable
    // (timestamped keys), so they may come from the HTTP cache; the track JSON
    // changes on rescore, so it is revalidated (ETag -> 304) on every view.
    const sourceAbort = new AbortController();
    const sourcePromise = sourceKey
      ? fetch(`${R2_PUBLIC_URL}/${sourceKey}`, { signal: sourceAbort.signal }).catch(() => null)
      : Promise.resolve(null);

    let track;
    try {
      const trackRes = await fetch(`${R2_PUBLIC_URL}/${trackFile}`, { cache: 'no-cache' });
      if (!trackRes.ok) throw new Error(`HTTP ${trackRes.status}`);
      track = await trackRes.json();
    } catch (e) {
      sourceAbort.abort();
      throw e;
    }
    const td = track.trackData;

    const scoreDetail = (fixes: any[]) => ({
      flight: { fixes },
      groundDist: td.groundDist,
      best: { scoreInfo: td.scoreInfo, opt: { scoring: td.scoring } },
      closed: td.closed,
    });

    if (td?.display) {
      // Newest format: compact display track precomputed by the pipeline
      sourceAbort.abort();
      return scoreDetail(decodeDisplayTrack(td.display));
    }

    if (td?.flightSegments) {
      // Parse the source IGC/GPX and apply stored flight segments.
      // GPX has no timezone header; look it up from the launch point while the
      // source is still downloading rather than after parsing it.
      const isGpx = /\.gpx$/i.test(sourceKey);
      const haveLaunch = Number.isFinite(launchLat) && Number.isFinite(launchLon) && (launchLat !== 0 || launchLon !== 0);
      const tzEarly = isGpx && haveLaunch ? timezoneAt(launchLat, launchLon) : null;

      const sourceRes = await sourcePromise;
      if (sourceRes?.ok) {
        const content = await sourceRes.text();
        let tz = igcTimeZone(content) ?? (tzEarly ? await tzEarly : null);
        if (!tz) {
          const first = parseFixes(content)[0];
          if (first) tz = await timezoneAt(first.latitude, first.longitude);
        }
        return scoreDetail(displayFixesFromSource(content, tz, td.flightSegments));
      }
    }
    sourceAbort.abort();

    if (td?.fixes) {
      // Intermediate format: full fixes stored in trackData
      return scoreDetail(td.fixes);
    }

    // Oldest format: downsampled coordinates array only
    const fixes = (track.coordinates || []).map(
      (c: [number, number, number]) => ({
        latitude: c[0], longitude: c[1], gpsAltitude: c[2],
        timestamp: 0, onGround: false,
      })
    );
    return {
      flight: { fixes },
      groundDist: 0,
      best: {
        scoreInfo: { tp: [], cp: null, ep: null, distance: 0, penalty: 0 },
        opt: { scoring: { code: "tri", multiplier: 1 } },
      },
      closed: false,
    };
  }

  loadFlights();
</script>
